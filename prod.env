PROD=1
DEBUG=0
SUBPATH=

DATA_DIR=/app/data/sync
NETCDF_DIR=/app/data/netcdf
TRACKS_NETCDF=tracks.nc
POLL_INTERVAL=300

PORTRAITS_DEFAULT=default.jpg
PUBLICATIONS_HTML_PATH=config/publications.html
HOME_HTML_PATH=config/homepage.html
DATAPAGE_HTML_PATH=config/datapage.html

# GoatCounter analytics. When set, the tracking snippet is injected into every
# page. Leave unset (e.g. in local dev) to disable tracking entirely.
ANALYTICS_ENDPOINT=https://analytics.gliders.whoi.edu
